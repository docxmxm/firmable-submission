nships_as_object": []}, {"author": "opendata@tmr.qld.gov.au", "author_email": "opendata@tmr.qld.gov.au", "creator_user_id": "369e0904-47af-44ec-b507-0bddb02177db", "data_driven_application": "NO", "data_last_updated": "2026-07-13T23:05:00.125952", "de_identified_data": "NO", "id": "abe00ded-8175-42cc-b054-3abd215f3eb8", "isopen": true, "license_id": "CC-BY-4.0", "license_title": "Creative Commons Attribution 4.0", "license_url": "https://creativecommons.org/licenses/by/4.0/", "maintainer": "opendata@tmr.qld.gov.au", "maintainer_email": "opendata@tmr.qld.gov.au", "metadata_created": "2018-02-07T23:30:02.881969", "metadata_modified": "2026-07-13T23:06:56.008092", "name": "limousine-and-taxi-licence-values-queensland", "next_update_due": "2026-11-14", "notes": "This dataset contains Queensland's limousine and taxi service licence values, including licence type, transfer values and locations. \r\n\r\nThe information published in this register includes transfer prices of taxi service licences and limousine licences. In December 2024 a complete review was undertaken to remove duplicate entries and anomalies to ensure data integrity and accuracy. Please disregard all previous versions.\r\n\r\nThe figures reflect the value of the licence only and do not include other costs associated with the sale, such as shares or vehicle costs. \r\n\r\nThe values may not always reflect \u2018arms length\u2019 transactions. For example, some transfers may be the result of a sale of partnership or organisational name change. In instances where a licence is transferred as a result of a business name change or a deceased estate, the licence value reflected in the register may be zero. In the case of taxi service licences, where the value of a licence transfer appears lower than average for that period, it may be the case that there were special conditions (for example \u2013 an owner/driver condition) imposed upon the licence at that time. \r\n\r\nThe Department of Transport and Main Roads (TMR) plays no part in commercial transactions between private parties and does not determine the market value of any taxi service licence or limousine licence. \r\n\r\nThe information published in this register is public information. Further enquiries about the information must be directed to [The Department of Transport and Main Roads Right to Information Unit.](https://www.tmr.qld.gov.au/About-us/Right-to-Information) In accordance with relevant privacy laws, TMR is unable to disclose personal details about any transaction unless required to do so by law.\r\n\r\n", "num_resources": 3, "num_tags": 4, "organization": {"id": "d540ffc8-b2e7-4e49-814a-5237f14a1ae9", "name": "transport-and-main-roads", "title": "Transport and Main Roads", "type": "organization", "description": "", "image_url": "", "created": "2013-08-14T23:20:45.690172", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "d540ffc8-b2e7-4e49-814a-5237f14a1ae9", "private": false, "schema_json": "", "schema_upload": "", "schema_url": "", "security_classification": "PUBLIC", "state": "active", "title": "Limousine and taxi service licence values \u2013 Queensland", "type": "dataset", "update_frequency": "quarterly", "url": "", "version": "June 2026", "groups": [{"description": "", "display_name": "Transportation", "id": "82cb68ff-c621-4837-978b-891a4239a630", "image_display_url": "", "name": "transportation", "title": "Transportation"}], "resources": [{"align_default_schema": false, "archiver": {"resource_timestamp": "2021-08-02T04:52:54.752035", "status_id": 0, "is_broken": false, "reason": "", "url_redirected_to": "https://www.data.qld.gov.au/dataset/abe00ded-8175-42cc-b054-3abd215f3eb8/resource/30f2297b-f3f4-46cb-b8e9-434c08db29cb/download/022018_glossary_taxi-and-limo.docx", "cache_filepath": "resources/30f2297b-f3f4-46cb-b8e9-434c08db29cb/022018_glossary_taxi-and-limo.docx", "cache_url": "https://www.data.qld.gov.au/dataset/abe00ded-8175-42cc-b054-3abd215f3eb8/resou